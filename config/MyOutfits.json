// Immersive Outfit Distribution - set file.
// Every *.json file in Data/SKSE/Plugins/ImmersiveOutfitDistribution/ is loaded at game start.
// Form references are "Plugin.esp|0xLocalID" (ESL plugins work too).
//
// Per set:
//   name         required, unique within this file
//   outfit       an outfit record the mod defines (all its armour pieces are used), and/or
//   pieces       a list of armour records
//   sources      "Radiant Raiment", "Khajiit caravans", "Thieves Guild"
//                Radiant Raiment only trades clothing and jewellery: armour sets placed there never
//                appear (the log warns). The caravans and fences trade anything.
//   rarity       "Common" (default), "Rare", "Legendary"
//   price        gold for the whole set (optional; spread over the pieces)
//   requirement  optional, one of:
//                  {"type": "level", "value": 10}
//                  {"type": "health" | "magicka" | "stamina", "value": 200}
//                  {"type": "skill", "skill": "Restoration", "value": 20}
//                  {"type": "faction", "faction": "Skyrim.esm|0x29DA9", "rank": 1}
//                  {"type": "quest", "quest": "Plugin.esp|0x...."}
//   unique       true (default): leaves rotation once you own every piece
//   enabled      true (default)
{
  "sets": [
    {
      "name": "Brutal Ravager",
      "outfit": "hdm_BrutalRavager.esp|0x846",
      "sources": ["Khajiit caravans", "Thieves Guild"],
      "rarity": "Common",
      "price": 1500
    },
    {
      "name": "Insane Dragon",
      "outfit": "Amsedillir-InsaneDragon.esp|0x90B",
      "sources": ["Khajiit caravans", "Thieves Guild"],
      "rarity": "Common",
      "price": 2500
    },
    // Cosplay Pack Gala has no outfit records (412 mix-and-match pieces in colour variants),
    // so its sets are listed piece by piece.
    {
      "name": "Thorn Princess",
      "pieces": [
        "[Caenarvon] Cosplay Pack Gala.esp|0xA1A",   // gown
        "[Caenarvon] Cosplay Pack Gala.esp|0xC52",   // crown
        "[Caenarvon] Cosplay Pack Gala.esp|0xC1E",   // gloves
        "[Caenarvon] Cosplay Pack Gala.esp|0xC1D",   // boots
        "[Caenarvon] Cosplay Pack Gala.esp|0xC53",   // earring
        "[Caenarvon] Cosplay Pack Gala.esp|0xC21",   // straps
        "[Caenarvon] Cosplay Pack Gala.esp|0xC1F"    // panties
      ],
      "sources": ["Radiant Raiment"],
      "rarity": "Rare",
      "price": 2000
    },
    {
      "name": "Patricia Velvet Gown",
      "pieces": [
        "[Caenarvon] Cosplay Pack Gala.esp|0xC2B",   // gown
        "[Caenarvon] Cosplay Pack Gala.esp|0xC2D",   // overlay
        "[Caenarvon] Cosplay Pack Gala.esp|0xCCC",   // ribbon high heels
        "[Caenarvon] Cosplay Pack Gala.esp|0xBA7",   // earrings 'Rio de Plata'
        "[Caenarvon] Cosplay Pack Gala.esp|0xE92"    // bracelet 'Clearwater'
      ],
      "sources": ["Radiant Raiment"],
      "rarity": "Common",
      "price": 1200
    }
  ]
}
